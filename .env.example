# Buddy API credentials for running tests
BUDDY_WORKSPACE=your-workspace
BUDDY_TOKEN=your-token

# Project the tests create their sandboxes in
BUDDY_PROJECT=your-project

# Workspace for sandboxes outside a project. Each scope suite skips
# when its variables are missing.
# BUDDY_TEST_WORKSPACE=your-test-workspace
# BUDDY_TEST_ENVIRONMENT=a-workspace-level-environment
# BUDDY_TEST_PROJECT=a-project-in-that-workspace
# BUDDY_TEST_PROJECT_ENVIRONMENT=a-project-level-environment

# Optional: API region (US, EU, or AS) - defaults to US
# BUDDY_REGION=US

# Optional: Custom API URL (for testing against different environments)
# BUDDY_API_URL=https://api.buddy.works
