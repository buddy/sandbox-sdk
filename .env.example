# Buddy API credentials for running tests
BUDDY_WORKSPACE=your-workspace
BUDDY_TOKEN=your-token

# Scope of created sandboxes - set one, or neither for workspace-level sandboxes.
# With both set, the sandbox goes to the environment and the project only says
# where to look the environment identifier up.
BUDDY_PROJECT=your-project

# Used by the scope tests, which expect a PROJECT-scoped environment living in
# BUDDY_PROJECT. The suite moves this variable aside while it runs so it cannot
# flip the remaining tests out of project scope.
# BUDDY_ENVIRONMENT=your-environment

# Optional: API region (US, EU, or AS) - defaults to US
# BUDDY_REGION=US

# Optional: Custom API URL (for testing against different environments)
# BUDDY_API_URL=https://api.buddy.works
